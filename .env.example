# --- Database ---------------------------------------------------------------
# Replace YOUR_PASSWORD with your PostgreSQL password (URL-encode special characters, e.g. @ becomes %40).
# Create the empty database first (pgAdmin: right-click Databases, Create, name it apaar_nexus).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/apaar_nexus"

# --- Cryptography (REQUIRED; generate your own: openssl rand -base64 32) ----
# AES-256-GCM key used to encrypt student PII at rest (name, DOB, APAAR ID).
DATA_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTES"
# Secret pepper for keyed HMAC-SHA256 matching hashes (APAAR ID, name+DOB, DOB).
HMAC_PEPPER="REPLACE_WITH_BASE64_32_BYTES"

# --- Demo mode ----------------------------------------------------------------
# Shows the demo-account panel on /login and seeds accounts with DEMO_PASSWORD.
# Set DEMO_MODE=false for anything that is not a demonstration.
DEMO_MODE="true"
DEMO_PASSWORD="Nexus@Demo2026"

# --- APAAR validation (configurable; confirm against the official spec) -------
# Structural rule only. Real, authoritative verification needs authorised API access.
APAAR_ID_PATTERN="^[0-9]{12}$"

# --- Cookies -------------------------------------------------------------------
# Production builds use Secure, __Host- prefixed session cookies. Chrome and Firefox accept these on
# http://localhost. For plain-HTTP LAN demos or Safari, set INSECURE_COOKIES=1 (never in real deployments).
# INSECURE_COOKIES="1"

# --- EnrolTrust additions (all optional) ----------------------------------------
# Ed25519 key for signing verification records. If unset, one is derived from DATA_ENCRYPTION_KEY,
# so nothing extra is needed. To use a dedicated key: openssl rand -base64 32
# CREDENTIAL_SIGNING_SEED=""
# Public origin used inside QR codes, e.g. https://nexus.example.in . Defaults to the address the page was opened on.
# APP_URL=""
# Reject upload rows that have no APAAR ID (default true).
# APAAR_REQUIRED="true"
# Trust Score weights (JSON, must sum to 100). Defaults are documented in docs/TRUST_SCORE.md.
# TRUST_WEIGHTS_JSON='{"completeness":20,"validity":20,"duplicates":15,"intake":20,"consistency":10,"timeliness":10,"conflicts":5}'
